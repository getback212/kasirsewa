APP_NAME=KasirSewa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://superbackend.my.id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=kasirsewa_pgsql
DB_PORT=5432
DB_DATABASE=kasirsewa_db
DB_USERNAME=kasirsewa_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=superbackend.my.id
SESSION_SAME_SITE=lax

REDIS_HOST=kasirsewa_redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@kasirsewa.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp gateway (whatsapp-gateway/server.js). Both the gateway container
# and the sending app/queue/scheduler containers read these, so the
# Authorization header always matches. Leave WA_API_KEY empty and the
# dispatcher skips the WhatsApp channel entirely (in-app + email still work).
WA_API_KEY=baileys_free_gateway
WA_GATEWAY_URL=http://kasirsewa_whatsapp:3001/send

# Custom domain (branding) via Cloudflare for SaaS. Leave the token empty and
# the app still accepts a tenant's own domain, but marks it `pending_dns`
# until the operator configures these — it never claims a domain is live
# without a real certificate.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CUSTOM_DOMAIN_TARGET=customers.superbackend.my.id
